<Window x:Class="MySqlBackupUtility.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MySQL Backup Utility" Height="640" Width="980"
        Icon="app.ico"
        MinHeight="520" MinWidth="800">
    <DockPanel>
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="StatusDot" Width="12" Height="12" Fill="Gray" Margin="0,0,6,0"/>
                    <TextBlock x:Name="StatusText" Text="Готов"/>
                </StackPanel>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem HorizontalContentAlignment="Stretch">
                <ProgressBar x:Name="WorkProgress" Width="220" Height="14" Minimum="0" Maximum="100" IsIndeterminate="False"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="WorkLabel" Text=""/>
            </StatusBarItem>
        </StatusBar>

        <TabControl x:Name="MainTabs" Margin="6">
            <!-- ДАШБОРД / ЗАДАЧИ -->
            <TabItem Header="Главная">
                <DockPanel>
                    <ToolBar DockPanel.Dock="Top">
                        <Button x:Name="BtnRefreshJobs" Content="Обновить" Click="BtnRefreshJobs_Click" Margin="2"/>
                        <Button x:Name="BtnBackupNow" Content="Создать бэкап сейчас" Click="BtnBackupNow_Click" Margin="2" FontWeight="Bold"/>
                        <Separator/>
                        <Button x:Name="BtnJobNew" Content="Новая задача" Click="BtnJobNew_Click" Margin="2"/>
                        <Button x:Name="BtnJobSave" Content="Сохранить задачу" Click="BtnJobSave_Click" Margin="2"/>
                        <Button x:Name="BtnJobDelete" Content="Удалить" Click="BtnJobDelete_Click" Margin="2"/>
                        <CheckBox x:Name="ChkSchedulerEnabled" Content="Планировщик вкл" IsChecked="True" VerticalAlignment="Center" Margin="8,0"/>
                    </ToolBar>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="2*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="1.2*"/>
                        </Grid.RowDefinitions>
                        <DataGrid x:Name="JobsGrid" Grid.Row="0" AutoGenerateColumns="False" IsReadOnly="True"
                                  SelectionMode="Single" SelectionChanged="JobsGrid_SelectionChanged" Margin="0,0,0,4">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Задача" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="Подключение" Binding="{Binding ConnectionName}" Width="140"/>
                                <DataGridTextColumn Header="БД" Binding="{Binding Database}" Width="110"/>
                                <DataGridTextColumn Header="Расписание" Binding="{Binding Kind}" Width="90"/>
                                <DataGridTextColumn Header="Статус" Binding="{Binding LastStatus}" Width="90"/>
                                <DataGridTextColumn Header="След. запуск" Binding="{Binding NextRunUtc}" Width="170"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" Background="#DDD"/>
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <Grid Margin="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/><ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="150"/><ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Название:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                                <TextBox x:Name="JobName" Grid.Row="0" Grid.Column="1" Margin="2"/>
                                <TextBlock Text="Подключение:" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center"/>
                                <ComboBox x:Name="JobConnection" Grid.Row="0" Grid.Column="3" Margin="2" DisplayMemberPath="Name"/>
                                <TextBlock Text="База данных:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
                                <TextBox x:Name="JobDatabase" Grid.Row="1" Grid.Column="1" Margin="2" ToolTip="Имя БД, несколько через запятую, или * — все базы"/>
                                <TextBlock Text="Периодичность:" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center"/>
                                <ComboBox x:Name="JobKind" Grid.Row="1" Grid.Column="3" Margin="2"/>
                                <TextBlock Text="Время (ЧЧ:ММ):" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"/>
                                <TextBox x:Name="JobTime" Grid.Row="2" Grid.Column="1" Margin="2" Text="03:00"/>
                                <TextBlock Text="Дни недели (0-6):" Grid.Row="2" Grid.Column="2" VerticalAlignment="Center"/>
                                <TextBox x:Name="JobDays" Grid.Row="2" Grid.Column="3" Margin="2" Text="1,2,3,4,5,6,0"/>
                                <TextBlock Text="Число месяца:" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center"/>
                                <TextBox x:Name="JobDom" Grid.Row="3" Grid.Column="1" Margin="2" Text="1"/>
                                <TextBlock Text="Интервал (мин):" Grid.Row="3" Grid.Column="2" VerticalAlignment="Center"/>
                                <TextBox x:Name="JobInterval" Grid.Row="3" Grid.Column="3" Margin="2" Text="360"/>
                                <TextBlock Text="Папка:" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
                                    <TextBox x:Name="JobFolder" Width="220" Margin="2"/>
                                    <Button x:Name="BtnJobBrowse" Content="..." Width="30" Click="BtnJobBrowse_Click"/>
                                </StackPanel>
                                <StackPanel Grid.Row="4" Grid.Column="2" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Хранить копий:" VerticalAlignment="Center"/>
                                    <TextBox x:Name="JobKeepN" Width="45" Margin="4,0" Text="7"/>
                                    <TextBlock Text="дней:" VerticalAlignment="Center"/>
                                    <TextBox x:Name="JobKeepD" Width="45" Margin="4,0" Text="7"/>
                                    <CheckBox x:Name="JobEnabled" Content="Включена" IsChecked="True" Margin="10,0"/>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </DockPanel>
            </TabItem>

            <!-- ПОДКЛЮЧЕНИЯ -->
            <TabItem Header="Подключения">
                <DockPanel>
                    <ToolBar DockPanel.Dock="Top">
                        <Button x:Name="BtnConnNew" Content="Новое" Click="BtnConnNew_Click" Margin="2"/>
                        <Button x:Name="BtnConnSave" Content="Сохранить" Click="BtnConnSave_Click" Margin="2"/>
                        <Button x:Name="BtnConnDelete" Content="Удалить" Click="BtnConnDelete_Click" Margin="2"/>
                        <Separator/>
                        <Button x:Name="BtnConnTest" Content="Проверить соединение" Click="BtnConnTest_Click" Margin="2"/>
                    </ToolBar>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="240"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ListBox x:Name="ConnList" Grid.Column="0" DisplayMemberPath="Name" SelectionChanged="ConnList_SelectionChanged" Margin="0,0,4,0"/>
                        <Grid Grid.Column="1" Margin="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Имя:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                            <TextBox x:Name="ConnName" Grid.Row="0" Grid.Column="1" Margin="2"/>
                            <TextBlock Text="Хост:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
                            <TextBox x:Name="ConnHost" Grid.Row="1" Grid.Column="1" Margin="2" Text="localhost"/>
                            <TextBlock Text="Порт:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"/>
                            <TextBox x:Name="ConnPort" Grid.Row="2" Grid.Column="1" Margin="2" Text="3306"/>
                            <TextBlock Text="Пользователь:" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center"/>
                            <TextBox x:Name="ConnUser" Grid.Row="3" Grid.Column="1" Margin="2" Text="root"/>
                            <TextBlock Text="Пароль:" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center"/>
                            <PasswordBox x:Name="ConnPass" Grid.Row="4" Grid.Column="1" Margin="2"/>
                            <TextBlock Text="Базы для бэкапа:" Grid.Row="5" Grid.Column="0" VerticalAlignment="Center"/>
                            <TextBox x:Name="ConnDb" Grid.Row="5" Grid.Column="1" Margin="2" IsReadOnly="True" Background="#F5F5F5"
                                     ToolTip="Выбираются галочками в списке ниже. * — все базы."/>
                            <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,4,0,0">
                                <Button x:Name="BtnConnLoadDb" Content="Обновить список БД" Click="BtnConnLoadDb_Click" Margin="2"/>
                                <Button x:Name="BtnConnDbAll" Content="Выбрать все" Click="BtnConnDbAll_Click" Margin="2"/>
                                <Button x:Name="BtnConnDbNone" Content="Снять выбор" Click="BtnConnDbNone_Click" Margin="2"/>
                            </StackPanel>
                            <ListBox x:Name="ConnDbCheckList" Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" MinHeight="140" Margin="2">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <!-- TextBlock вместо строки: иначе WPF трактует '_' как access key и прячет его -->
                                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                  Checked="ConnDbCheck_Changed" Unchecked="ConnDbCheck_Changed">
                                            <TextBlock Text="{Binding Name}"/>
                                        </CheckBox>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <CheckBox x:Name="ConnSsl" Grid.Row="8" Grid.Column="1" Content="Использовать SSL/TLS" Margin="2"/>
                            <TextBlock x:Name="ConnTestResult" Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="2" TextWrapping="Wrap" Margin="2" Foreground="DarkBlue"/>
                        </Grid>
                    </Grid>
                </DockPanel>
            </TabItem>

            <!-- АРХИВЫ -->
            <TabItem Header="Архивы">
                <DockPanel>
                    <ToolBar DockPanel.Dock="Top">
                        <Button x:Name="BtnArchRefresh" Content="Обновить" Click="BtnArchRefresh_Click" Margin="2"/>
                        <Button x:Name="BtnArchRestore" Content="Восстановить..." Click="BtnArchRestore_Click" Margin="2" FontWeight="Bold"/>
                        <Button x:Name="BtnArchFromFile" Content="Восстановить из файла..." Click="BtnArchFromFile_Click" Margin="2"/>
                        <Button x:Name="BtnArchDelete" Content="Удалить" Click="BtnArchDelete_Click" Margin="2"/>
                        <Button x:Name="BtnArchOpenFolder" Content="Открыть папку" Click="BtnArchOpenFolder_Click" Margin="2"/>
                    </ToolBar>
                    <DataGrid x:Name="ArchGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Файл" Binding="{Binding FilePath}" Width="*"/>
                            <DataGridTextColumn Header="Размер, МБ" Binding="{Binding SizeBytes}" Width="110"/>
                            <DataGridTextColumn Header="Создан (UTC)" Binding="{Binding CreatedUtc}" Width="180"/>
                            <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ЛОГИ -->
            <TabItem Header="Логи">
                <DockPanel>
                    <ToolBar DockPanel.Dock="Top">
                        <Button Content="Обновить" Click="BtnLogsRefresh_Click" Margin="2"/>
                    </ToolBar>
                    <DataGrid x:Name="LogsGrid" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Время (UTC)" Binding="{Binding TimestampUtc}" Width="180"/>
                            <DataGridTextColumn Header="Уровень" Binding="{Binding Level}" Width="70"/>
                            <DataGridTextColumn Header="Задача" Binding="{Binding JobName}" Width="150"/>
                            <DataGridTextColumn Header="Сообщение" Binding="{Binding Message}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- НАСТРОЙКИ -->
            <TabItem Header="Настройки">
                <ScrollViewer>
                    <StackPanel Margin="10" Width="600" HorizontalAlignment="Left">
                        <TextBlock Text="Папка бэкапов по умолчанию:" FontWeight="Bold"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBox x:Name="CfgDefaultFolder" Width="420" Margin="0,0,6,0"/>
                            <Button Content="..." Width="30" Click="BtnCfgBrowse_Click"/>
                            <Button Content="Сохранить" Margin="6,0" Click="BtnCfgSave_Click"/>
                        </StackPanel>
                        <TextBlock Text="Утилиты MySQL/MariaDB (mysqldump, mysql):" FontWeight="Bold" Margin="0,12,0,0"/>
                        <TextBlock x:Name="CfgToolsStatus" TextWrapping="Wrap" Margin="0,4"/>
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="mysqldump:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                            <TextBox x:Name="CfgDumpPath" Grid.Row="0" Grid.Column="1" Margin="2"/>
                            <Button Content="..." Grid.Row="0" Grid.Column="2" Width="30" Margin="2" Click="BtnCfgDumpBrowse_Click"/>
                            <TextBlock Text="mysql:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
                            <TextBox x:Name="CfgMysqlPath" Grid.Row="1" Grid.Column="1" Margin="2"/>
                            <Button Content="..." Grid.Row="1" Grid.Column="2" Width="30" Margin="2" Click="BtnCfgMysqlBrowse_Click"/>
                            <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,4,0,0">
                                <Button Content="Авто-поиск" Click="BtnCfgToolsAuto_Click" Margin="2" ToolTip="Искать в Program Files (MariaDB/MySQL), XAMPP и PATH"/>
                                <Button Content="Сохранить пути" Click="BtnCfgToolsSave_Click" Margin="2"/>
                            </StackPanel>
                        </Grid>
                        <CheckBox x:Name="CfgTray" Content="Сворачивать в трей при закрытии окна" IsChecked="True" Margin="0,12,0,0"/>
                        <TextBlock Text="Планировщик: встроенный (работает пока программа запущена, в т.ч. в трее). Для запуска без входа пользователя используйте Windows Task Scheduler (см. README)." TextWrapping="Wrap" Margin="0,12,0,0" Foreground="Gray"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
