<!-- MSI-установщик MySQL Backup Utility (WiX v5, свободная лицензия MS-RL).
     Вариант 1: установка для всех пользователей в Program Files.
     ТРЕБУЕТ ПРАВ АДМИНИСТРАТОРА (подтвердить запрос UAC).
     Для установки без прав администратора используйте ...-peruser.msi.
     Сборка: installer/build.ps1 (требуется: dotnet SDK и WiX v5 tool). -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="MySQL Backup Utility"
           Language="1049"
           Version="0.1.0"
           Manufacturer="gxpbackup"
           Scope="perMachine"
           UpgradeCode="95B71294-4054-4E30-BF99-3151F30AA9EC">
    <MajorUpgrade DowngradeErrorMessage="Установлена более новая версия MySQL Backup Utility." />
    <Media Id="1" Cabinet="app.cab" EmbedCab="yes" />

    <Icon Id="AppIcon" SourceFile="C:\gxpbackup\src\MySqlBackupUtility\app.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />

    <Feature Id="Main" Title="MySQL Backup Utility" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="C_NativeLibs" />
    </Feature>

    <!-- Всё в single-file exe (self-contained, .NET 8) + нативные библиотеки WPF.
         PublishSingleFile НЕ вшивает native DLL (D3DCompiler_47_cor3, e_sqlite3,
         PenImc_cor3, PresentationNative_cor3, vcruntime140_cor3, wpfgfx_cor3) —
         они подгружаются из папки рядом с exe. Без них WPF падает при создании
         окна с DllNotFoundException, поэтому ставим их обязательно. -->
    <ComponentGroup Id="AppFiles">
      <ComponentRef Id="C_MainExe" />
    </ComponentGroup>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="MySqlBackupUtility" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppMenuDir" Name="MySQL Backup Utility" />
    </StandardDirectory>

    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="C_MainExe" Bitness="always64">
        <File Id="MainExe" Source="C:\gxpbackup\dist\stage\MySqlBackupUtility.exe" KeyPath="yes">
          <Shortcut Id="StartMenuExe"
                    Directory="AppMenuDir"
                    Name="MySQL Backup Utility"
                    Description="Резервное копирование MySQL"
                    WorkingDirectory="INSTALLFOLDER"
                    Icon="AppIcon" />
          <Shortcut Id="DesktopExe"
                    Directory="DesktopFolder"
                    Name="MySQL Backup Utility"
                    Description="Резервное копирование MySQL"
                    WorkingDirectory="INSTALLFOLDER"
                    Icon="AppIcon" />
        </File>
        <RemoveFolder Id="RemoveAppMenuDir" Directory="AppMenuDir" On="uninstall" />
        <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
      </Component>

      <!-- Нативные библиотеки, без которых WPF не создаёт окно. -->
      <Component Id="C_NativeLibs" Guid="9D4B7E15-27C8-4A93-B5D6-1E4F8A03C7B6" Bitness="always64">
        <File Id="NativeD3DCompiler" Source="C:\gxpbackup\dist\stage\D3DCompiler_47_cor3.dll" KeyPath="yes" />
        <File Id="NativeSqlite" Source="C:\gxpbackup\dist\stage\e_sqlite3.dll" />
        <File Id="NativePenImc" Source="C:\gxpbackup\dist\stage\PenImc_cor3.dll" />
        <File Id="NativePresentation" Source="C:\gxpbackup\dist\stage\PresentationNative_cor3.dll" />
        <File Id="NativeVcruntime" Source="C:\gxpbackup\dist\stage\vcruntime140_cor3.dll" />
        <File Id="NativeWpfgfx" Source="C:\gxpbackup\dist\stage\wpfgfx_cor3.dll" />
      </Component>
    </DirectoryRef>

    <!-- Запуск программы сразу после установки. Условие UILevel>=3 => при тихой
         установке (/qn, UILevel=2) программа не запускается. -->
    <CustomAction Id="LaunchApp" FileRef="MainExe" ExeCommand="" Execute="immediate" Return="asyncNoWait" />
    <InstallExecuteSequence>
      <Custom Action="LaunchApp" After="InstallFinalize" Condition="NOT REMOVE AND UILevel &gt;= 3" />
    </InstallExecuteSequence>
  </Package>
</Wix>
